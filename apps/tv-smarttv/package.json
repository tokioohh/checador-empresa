{
  "name": "tv-smarttv",
  "productName": "Checador Empresa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "author": "Tu Empresa",
  "description": "Sistema de registro de asistencia para Smart TV y Desktop",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "serve": "npm run build && npx serve dist -l 3000 --cors",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:win": "npm run build && electron-builder --win",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:linux": "npm run build && electron-builder --linux",
    "electron:start": "electron .",
    "build:tizen": "npm run build && npm run package:tizen",
    "build:webos": "npm run build && npm run package:webos",
    "package:tizen": "cd dist && tizen package -t wgt -s MyProfile -- .",
    "package:webos": "ares-package dist -o ./ && echo 'Package created: com.tuempresa.checador_1.0.0_all.ipk'",
    "deploy:tizen": "npm run build:tizen && tizen install -n dist/checador.wgt",
    "deploy:webos": "npm run build:webos && ares-install com.tuempresa.checador_1.0.0_all.ipk",
    "info": "echo '\n📺 Smart TV Webapp - Build Info\n' && echo '📦 Build size: ' && du -sh dist/ && echo '\n🚀 Quick start: npm run serve' && echo '📖 Full guide: See DEPLOYMENT.md\n'"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^10.0.5",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "globals": "^16.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.tuempresa.checador",
    "productName": "Checador Empresa",
    "directories": {
      "output": "release",
      "buildResources": "electron/resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "electron/resources/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "electron/resources/icon.icns",
      "category": "public.app-category.business",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "electron/resources/icon.png",
      "category": "Office",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Checador Empresa"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
