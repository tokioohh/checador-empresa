# Copia este archivo a `.env` y reemplaza los valores `changeme_*` por secretos reales.

# --- Postgres ---
POSTGRES_USER=checador
POSTGRES_PASSWORD=changeme_postgres_password
POSTGRES_DB=checador_db

# Usada por Prisma. En dev apunta a `localhost:5432` (puerto publicado por Docker).
# La contraseña debe coincidir con POSTGRES_PASSWORD.
DATABASE_URL=postgresql://checador:changeme_postgres_password@localhost:5432/checador_db

# --- Backend / API ---
PORT=4000

# Secreto para firmar los JWT de sesión de admin. Generar uno largo y aleatorio:
#   openssl rand -hex 32
JWT_SECRET=changeme_jwt_secret

# Secreto para firmar los tokens del QR de asistencia (HMAC). No se guarda en BD,
# se valida contra este secreto + expiración embebida (rota cada 30s).
QR_SECRET=changeme_qr_secret

# Ruta donde se guardan fotos y archivos multimedia.
# En dev local: ./storage  (relativo a la raíz del monorepo).
# Dentro de docker-compose se sobreescribe a /app/storage.
STORAGE_PATH=./storage

# Duración del código de activación de dispositivo (horas)
ACTIVATION_CODE_TTL_HOURS=4

# Tolerancia en minutos para considerar un registro "a tiempo"
PUNTUALIDAD_TOLERANCIA_MIN=15

# --- Seed del primer admin (opcional, solo se usa al correr `npm run prisma:seed`) ---
ADMIN_SEED_EMAIL=admin@empresa.com
ADMIN_SEED_PASSWORD=changeme123
ADMIN_SEED_NOMBRE=Administrador
