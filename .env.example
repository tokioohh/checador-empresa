# --- Postgres ---
POSTGRES_USER=checador
POSTGRES_PASSWORD=changeme
POSTGRES_DB=checador_db

# Usada por Prisma (apunta al servicio "postgres" dentro de docker-compose)
DATABASE_URL=postgresql://checador:changeme@localhost:5432/checador_db

# --- Backend / API ---
PORT=4000

# Secreto para firmar los JWT de sesión de admin. Generar uno propio y largo en producción.
JWT_SECRET=changeme_jwt_secret

# Secreto para firmar los tokens del QR de asistencia (HMAC). No se guarda en BD,
# se valida contra este secreto + expiración embebida (rota cada 30s).
QR_SECRET=changeme_qr_secret

# Ruta donde se guardan fotos de asistencia y archivos multimedia (dentro del contenedor)
STORAGE_PATH=/app/storage

# Duración del código de activación de dispositivo (horas)
ACTIVATION_CODE_TTL_HOURS=4

# Tolerancia en minutos para considerar un registro "a tiempo"
PUNTUALIDAD_TOLERANCIA_MIN=15

# --- Seed del primer admin (opcional, solo se usa al correr `npm run prisma:seed`) ---
ADMIN_SEED_EMAIL=admin@empresa.com
ADMIN_SEED_PASSWORD=changeme123
ADMIN_SEED_NOMBRE=Administrador
