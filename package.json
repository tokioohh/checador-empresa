{
  "name": "checador-empresa",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w apps/backend",
    "dev:tv": "npm run dev -w apps/tv-webapp",
    "dev:admin": "npm run dev -w apps/admin-web",
    "build:backend": "npm run build -w apps/backend",
    "build:tv": "npm run build -w apps/tv-webapp",
    "build:admin": "npm run build -w apps/admin-web",
    "start:backend": "npm run start -w apps/backend",
    "prisma:generate": "npm run prisma:generate -w apps/backend",
    "prisma:migrate": "npm run prisma:migrate -w apps/backend --",
    "prisma:seed": "npm run prisma:seed -w apps/backend"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true,
    "bcrypt": true,
    "esbuild": true
  },
  "overrides": {
    "mysql2": "^3.24.4",
    "deepmerge-ts": "^8.0.2"
  }
}
